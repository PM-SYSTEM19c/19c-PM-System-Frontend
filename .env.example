# Fixed server-side upstream. Browser requests always use /api/v1.
BACKEND_API_URL=http://localhost:3000/api/v1

# Server-only secret, identical in Vercel and Railway (minimum 32 random characters).
# Required on Vercel for signed visitor-IP metadata. Never use NEXT_PUBLIC_ prefix.
# API_PROXY_SECRET=<generate-a-new-random-secret>

# Public backend origin used only to recognize existing attachment URLs.
NEXT_PUBLIC_BE_URL=http://localhost:3000/api/v1

# Optional exact frontend origin for CSRF checks. Production:
# SESSION_SITE_ORIGIN=https://nodewave-frontend-plum.vercel.app

# Public Production/Staging Site URL (optional, for sitemap/robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
